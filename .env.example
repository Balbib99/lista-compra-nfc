# Copia este archivo a ".env" en la Raspberry Pi y rellena los valores reales.
# El ".env" real NUNCA se sube a git (ya está en .gitignore).

# Dominio completo de DuckDNS que apunta a esta Raspberry Pi
DOMAIN=despensa4b.duckdns.org

# Solo el subdominio (sin ".duckdns.org")
DUCKDNS_SUBDOMAIN=despensa4b

# Token de tu cuenta DuckDNS (aparece arriba en duckdns.org al iniciar sesión)
DUCKDNS_API_TOKEN=
