# Copia este archivo a ".env" en la Raspberry Pi y rellena los valores reales.
# El ".env" real NUNCA se sube a git (ya está en .gitignore).

# Dominio completo de DuckDNS que apunta a esta Raspberry Pi
DOMAIN=despensa4b.duckdns.org

# Solo el subdominio (sin ".duckdns.org")
DUCKDNS_SUBDOMAIN=despensa4b

# Token de tu cuenta DuckDNS (aparece arriba en duckdns.org al iniciar sesión)
DUCKDNS_API_TOKEN=

# Protección extra del panel admin de PocketBase (/_/), aparte de tu email/contraseña de superusuario.
# ADMIN_USER: el nombre de usuario que quieras (no tiene que coincidir con tu email de PocketBase).
# ADMIN_PASSWORD_HASH: genera el hash en la propia Pi con:
#   docker compose exec caddy caddy hash-password --algorithm bcrypt
# (te pedirá la contraseña sin mostrarla en pantalla, y te da el hash para pegar aquí)
ADMIN_USER=
ADMIN_PASSWORD_HASH=
